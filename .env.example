# 会计审计智能体 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===========================================
# 基础配置
# ===========================================

# 服务器监听地址
AUDIT_AGENT_HOST=127.0.0.1

# 服务器监听端口
AUDIT_AGENT_PORT=7860

# 默认行业（可选值：制造业、SaaS、互联网平台、通用）
AUDIT_AGENT_DEFAULT_INDUSTRY=制造业

# ===========================================
# 大模型配置
# ===========================================

# 模型提供商（可选值：dashscope、openai-compatible、openrouter、ollama、mock）
AUDIT_AGENT_MODEL_PROVIDER=dashscope

# 模型名称（根据提供商选择合适模型）
# dashscope: qwen-flash, qwen-plus, qwen-max
# openai-compatible: gpt-4o-mini, gpt-4o, claude-3-haiku
# ollama: qwen2.5:7b, llama3.2:3b, mistral:7b
AUDIT_AGENT_MODEL_NAME=qwen-flash

# API 密钥（必填，否则系统以离线模式运行）
# 阿里云百炼获取地址: https://dashscope.console.aliyun.com/
# OpenAI获取地址: https://platform.openai.com/api-keys
AUDIT_AGENT_API_KEY=your-api-key-here

# API 端点（大多数情况下使用默认值即可）
# 阿里云百炼
AUDIT_AGENT_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI（如果使用OpenAI）
# AUDIT_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama本地部署（如果使用Ollama）
# AUDIT_AGENT_OPENAI_BASE_URL=http://localhost:11434

# 模型温度（0.0-1.0，越低越确定性，越高越创造性）
AUDIT_AGENT_MODEL_TEMPERATURE=0.2

# ===========================================
# 文档导入配置（可选）
# ===========================================

# 启用远程文档导入（需要阿里云百炼API密钥）
AUDIT_AGENT_ENABLE_REMOTE_IMPORT=false

# 文档处理模型
AUDIT_AGENT_DOC_MODEL_NAME=qwen-doc-turbo

# 视觉识别模型（用于图片类文档）
AUDIT_AGENT_VISION_MODEL_NAME=qwen-vl-ocr-latest
